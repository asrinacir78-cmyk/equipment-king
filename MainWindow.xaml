<Window x:Class="EquipmentKing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment King" Height="780" Width="940" MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen" Background="#0B1017" Foreground="#F4F7FA"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA8B7" />
        <SolidColorBrush x:Key="PanelBrush" Color="#121B25" />
        <SolidColorBrush x:Key="LineBrush" Color="#253442" />
        <SolidColorBrush x:Key="AccentBrush" Color="#70E1B8" />
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Foreground" Value="#08130F" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8BEBCB" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="34,28,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="15" Background="#173229" Margin="0,0,14,0">
                    <TextBlock Text="♛" Foreground="{StaticResource AccentBrush}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EQUIPMENT KING" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Your devices, at a glance" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource RefreshButton}" Click="RefreshButton_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="Refresh" /></StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="20,17">
                <StackPanel>
                    <TextBlock Text="CONNECTED DEVICES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock x:Name="ConnectedCount" Text="—" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="online" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="9,10,0,0" /></StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="20,17">
                <StackPanel>
                    <TextBlock Text="BATTERY LEVELS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock x:Name="BatteryCount" Text="—" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="reported" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="9,10,0,0" /></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="1,0,1,12">
            <TextBlock Text="Paired and connected accessories" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="UpdateText" Text="Looking for devices…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </Grid>
        <Grid Grid.Row="3">
            <Border Style="{StaticResource PanelBorder}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DeviceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#17222D" BorderBrush="#263744" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="2,2,2,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="13" Background="#20352F" VerticalAlignment="Center"><TextBlock Text="{Binding Icon}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="6,0,0,0" />
                                                <TextBlock Text=" · " Foreground="#607182" FontSize="11" />
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,10,0">
                                            <ProgressBar Height="6" Maximum="100" Value="{Binding BatteryValue}" Background="#2A3945" Foreground="{Binding BatteryBrush}" BorderThickness="0" />
                                            <TextBlock Text="{Binding BatteryNote}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding BatteryText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding BatteryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410" Visibility="Collapsed">
                <TextBlock Text="◉" FontSize="42" Foreground="#4A6A60" HorizontalAlignment="Center" />
                <TextBlock Text="No accessories found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Pair a Bluetooth device or connect its wireless receiver, then refresh." Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="4" Margin="2,13,2,0" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap">
            Battery readings depend on what Windows and the device report. Some receiver-based accessories need vendor software to expose battery data.
        </TextBlock>
    </Grid>
</Window>
